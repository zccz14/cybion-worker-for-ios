diff --git a/include/ios_stubs.h b/include/ios_stubs.h
new file mode 100644
index 0000000..c3a71b3
--- /dev/null
+++ b/include/ios_stubs.h
@@ -0,0 +1,27 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * iOS (Apple) compatibility stubs for functions the iOS SDK marks
+ * `unavailable`. The macOS SDK still declares them, the iOS SDK does not
+ * (nor may sandboxed apps execute /bin/sh), so code paths that busybox
+ * compiles unconditionally - even dead ones behind run-time constants -
+ * would otherwise fail to build.
+ *
+ * Included at the end of libbb.h, after every system header, so the macro
+ * definitions below cannot interfere with the SDK's own declarations.
+ *
+ * Licensed under GPLv2, see file LICENSE in this source tree.
+ */
+#if defined(__APPLE__)
+
+# undef system
+# undef popen
+# undef pclose
+
+/* Building a shell command from a registered applet is not possible on iOS:
+ * spawning needs an explicit, sandbox-visible executable path, which the
+ * C library helpers cannot know. Report ENOSYS instead of pretending. */
+# define system(cmd) (errno = ENOSYS, -1)
+# define popen(cmd, mode) ((FILE *)(errno = ENOSYS, (void *)0))
+# define pclose(stream) (errno = ENOSYS, -1)
+
+#endif
