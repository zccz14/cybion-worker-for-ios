diff --git a/scripts/arbb.sh b/scripts/arbb.sh
new file mode 100755
index 0000000..17c22db
--- /dev/null
+++ b/scripts/arbb.sh
@@ -0,0 +1,12 @@
+#!/bin/sh
+# Wrapper around ar for cross-building busybox on hosts whose ar cannot
+# create archives with no members (Apple's ar refuses; GNU ar tolerates).
+# busybox legitimately creates empty archives for directories whose applets
+# are all disabled. Usage mirrors: ar [flags] archive [members...].
+flags=$1; shift
+archive=$1; shift
+if [ $# -eq 0 ]; then
+  printf '!<arch>\n' > "$archive"
+else
+  exec /usr/bin/ar "$flags" "$archive" "$@"
+fi
diff --git a/scripts/trylink b/scripts/trylink
index 2255dee..17cbe80 100755
--- a/scripts/trylink
+++ b/scripts/trylink
@@ -93,10 +93,30 @@ if ! check_cc "-Wl,--sort-section,alignment"; then
     SORT_SECTION=""
 fi
 
-START_GROUP="-Wl,--start-group"
-END_GROUP="-Wl,--end-group"
+# The --start-group option is not supported by Apple's linker; fall back to
+# -all_load so circular references between the busybox archives still resolve.
+START_GROUP=""
+END_GROUP=""
+ALL_LOAD=""
+if ! check_cc "-Wl,--start-group -Wl,--end-group"; then
+    echo "Your linker does not support --start-group; using -all_load"
+    ALL_LOAD="-Wl,-all_load"
+else
+    START_GROUP="-Wl,--start-group"
+    END_GROUP="-Wl,--end-group"
+fi
+# GNU ld supports --warn-common and --verbose and spell the map flag -Map;
+# Apple's linker only has -map (and rejects the other two).
+INFO_FLAGS="-Wl,--warn-common -Wl,-Map,$EXE.map -Wl,--verbose"
+if ! check_cc "$INFO_FLAGS"; then
+    echo "Your linker does not support GNU info options"
+    INFO_FLAGS="-Wl,-map,$EXE.map"
+    if ! check_cc "$INFO_FLAGS"; then
+        INFO_FLAGS=""
+    fi
+fi
 INFO_OPTS() {
-	echo "-Wl,--warn-common -Wl,-Map,$EXE.map -Wl,--verbose"
+	echo "$INFO_FLAGS"
 }
 
 # gold may not support --sort-common (yet)
@@ -139,7 +159,7 @@ try $CC $CFLAGS $LDFLAGS \
 	$SORT_COMMON \
 	$SORT_SECTION \
 	$GC_SECTIONS \
-	$START_GROUP $O_FILES $A_FILES $END_GROUP \
+	$START_GROUP $ALL_LOAD $O_FILES $A_FILES $END_GROUP \
 	$l_list \
 || {
     echo "Failed: $l_list"
